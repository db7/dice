; Topology excerpt from Lotto's mutex/cxa subscribers and runtime ingress.
; This describes the boundary into ingress, not a complete Lotto runtime.
; Port the corresponding C handlers to dice.h and SLOT_* before linking.
(import (mod self) (mod pthread_create) (mod pthread_mutex) (mod cxa))
(runtime (plugins true))

; Optional pins can preserve Lotto's existing ABI during migration:
; (events (EVENT_MUTEX_ACQUIRE 142)
;         (EVENT_MUTEX_TRYACQUIRE 143) (EVENT_MUTEX_RELEASE 144))
; (chains (CHAIN_INGRESS_EVENT 9) (CHAIN_INGRESS_BEFORE 10)
;         (CHAIN_INGRESS_AFTER 11) (CHAIN_LOTTO_TRAP 14))

(slot lotto-mutex
  (after dice-self)
  (before lotto-ingress)
  (consumes
    (CAPTURE_BEFORE EVENT_MUTEX_LOCK EVENT_MUTEX_TRYLOCK
                    EVENT_MUTEX_UNLOCK)
    (CHAIN_LOTTO_TRAP EVENT_MUTEX_TRYACQUIRE))
  (produces
    (CHAIN_INGRESS_EVENT EVENT_MUTEX_ACQUIRE EVENT_MUTEX_TRYACQUIRE
                         EVENT_MUTEX_RELEASE)))

(slot lotto-cxa
  (after dice-self)
  (before lotto-ingress)
  (consumes
    (CAPTURE_BEFORE EVENT_CXA_GUARD_ACQUIRE)
    (CAPTURE_AFTER EVENT_CXA_GUARD_ACQUIRE))
  (produces
    (CHAIN_INGRESS_BEFORE EVENT_CXA_GUARD_ACQUIRE)
    (CHAIN_INGRESS_AFTER EVENT_CXA_GUARD_ACQUIRE)))

(slot lotto-ingress
  (consumes
    (CHAIN_INGRESS_EVENT ANY_EVENT)
    (CHAIN_INGRESS_BEFORE ANY_EVENT)
    (CHAIN_INGRESS_AFTER ANY_EVENT)))
