(import (dice self) (dice pthread_create) (dice malloc))
(callbacks true)
(prioritize (chains INTERCEPT_EVENT CAPTURE_EVENT)
            (events EVENT_THREAD_START EVENT_THREAD_EXIT))

; Events and chains are inferred from consumes/produces.
(slot observer
  (after (dice self))
  (consumes (CAPTURE_BEFORE EVENT_MALLOC)
            (CAPTURE_EVENT EVENT_THREAD_START EVENT_THREAD_EXIT)))

(slot preload-observer
  (consumes (CAPTURE_BEFORE EVENT_MALLOC)))
