(slot pthread-mutex
  (consumes (CHAIN_DICE_CONTROL EVENT_DICE_INIT))
  (produces (INTERCEPT_BEFORE EVENT_MUTEX_LOCK EVENT_MUTEX_TIMEDLOCK
                EVENT_MUTEX_TRYLOCK EVENT_MUTEX_UNLOCK EVENT_MUTEX_CLOCKLOCK)
            (INTERCEPT_AFTER EVENT_MUTEX_LOCK EVENT_MUTEX_TIMEDLOCK
                EVENT_MUTEX_TRYLOCK EVENT_MUTEX_UNLOCK EVENT_MUTEX_CLOCKLOCK)))
