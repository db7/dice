(dice (schema 1)
  (plugins true)
  ; Exercise preferred exact handlers, wildcard events in the fallback, and
  ; publications to an unprioritized chain with the same event.
  (prioritize (chains CHAIN_FLOW) (events EVENT_TEST))
  ; Numeric order deliberately differs from name order, with unused IDs between.
  (chains (CHAIN_FLOW 15) (CHAIN_OTHER 7))
  (slot early (number 2)
    (consumes (CHAIN_FLOW EVENT_TEST ANY_EVENT)
              (CHAIN_OTHER EVENT_OTHER)))
  (slot direct (number 4)
    (consumes (CHAIN_FLOW EVENT_TEST)))
  (slot middle (number 6)
    (consumes (CHAIN_FLOW ANY_EVENT)))
  (slot last (number 8)
    (consumes (CHAIN_FLOW EVENT_TEST ANY_EVENT)))
  ; A produces-only slot still contributes to the global dispatch boundary.
  (slot source (number 10)
    (produces (CHAIN_FLOW EVENT_TEST EVENT_OTHER)
              (CHAIN_OTHER EVENT_OTHER))))
